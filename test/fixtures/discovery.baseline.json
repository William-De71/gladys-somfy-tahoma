        }
      ]
    }
  ],
  "scene_triggers": [
    {
      "key": "command_failed",
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices"
        }
      ],
      "variables": [
        {
          "key": "device_name",
          "type": "string"
        },
        {
          "key": "failure_type",
          "type": "string"
        },
        {
          "key": "label",
          "type": "string"
        }
      ]
    },
    {
      "key": "device_availability_changed",
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices"
        },
        {
          "key": "state",
          "type": "select",
          "values": ["unavailable", "available"]
        }
      ],
      "variables": [
        {
          "key": "device_name",
          "type": "string"
        }
      ]
    },
    {
      "key": "box_connection_changed",
      "fields": [
        {
          "key": "state",
          "type": "select",
          "values": ["offline", "online"]
        }
      ],
      "variables": [
        {
          "key": "transport",
          "type": "string"
        },
        {
          "key": "pin",
          "type": "string"
        }
      ]
    }
  ],
  "scene_actions": [
    {
      "key": "run_scenario",
      "fields": [
        {
          "key": "scenario",
          "type": "string"
        }
      ],
      "outputs": [
        {
          "key": "exec_id",
          "type": "string"
        },
        {
          "key": "scenario",
          "type": "string"
        },
        {
          "key": "transport",
          "type": "string"
        }
      ]
    },
    {
      "key": "send_command",
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices"
        },
        {
          "key": "command",
          "type": "select",
          "values": ["open", "close", "stop", "my", "identify"]
        }
      ],
      "outputs": [
        {
          "key": "exec_id",
          "type": "string"
        },
        {
          "key": "transport",
          "type": "string"
        }
      ]
    }
  ]
